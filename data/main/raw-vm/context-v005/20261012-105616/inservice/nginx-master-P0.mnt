/ / rw,relatime ext4
/ /dev rw,relatime devtmpfs
/ /dev/hugepages rw,nosuid,nodev,relatime hugetlbfs
/ /dev/mqueue rw,nosuid,nodev,noexec,relatime mqueue
/ /dev/pts rw,nosuid,noexec,relatime devpts
/ /dev/shm rw,nosuid,nodev tmpfs
/ /proc rw,nosuid,noexec,relatime proc
/ /proc/sys/fs/binfmt_misc rw,relatime autofs
/ /run rw,relatime tmpfs
/ /run/credentials/systemd-journald.service ro,nosuid,nodev,noexec,relatime,nosymfollow tmpfs
/ /run/user/0 rw,nosuid,nodev,relatime tmpfs
/ /run/user/47 rw,nosuid,nodev,relatime tmpfs
/ /sys rw,nosuid,nodev,noexec,relatime sysfs
/ /sys/fs/bpf rw,nosuid,nodev,noexec,relatime bpf
/ /sys/fs/cgroup rw,nosuid,nodev,noexec,relatime cgroup2
/ /sys/fs/fuse/connections rw,nosuid,nodev,noexec,relatime fusectl
/ /sys/fs/pstore rw,nosuid,nodev,noexec,relatime pstore
/ /sys/kernel/config rw,nosuid,nodev,noexec,relatime configfs
/ /sys/kernel/debug rw,nosuid,nodev,noexec,relatime debugfs
/ /sys/kernel/security rw,nosuid,nodev,noexec,relatime securityfs
/ /sys/kernel/tracing rw,nosuid,nodev,noexec,relatime tracefs
/ /tmp rw,nosuid,relatime tmpfs
